{
  "name": "vinhan",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android-dev": "react-native run-android --mode=devDebug",
    "android-prod": "react-native run-android --mode=prodDebug",
    "ios": "react-native run-ios",
    "openXcode": "xed -b ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "postinstall": "patch-package && npx jetify",
    "all": "watchman watch-del-all && rm -rf package-lock.json && rm -rf node_modules/ && rm -fr $TMPDIR/metro* && yarn install && cd ios && rm -rf Pods && rm -rf Podfile.lock && pod install && cd ..",
    "pod": "cd ios && pod install && cd ..",
    "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "android:dev": "cd android && ./gradlew installDevDebug && cd .. && npx react-native start",
    "android:prod": "cd android && ./gradlew installProdDebug && cd .. && npx react-native start",
    "build:android:dev": "cd android && ./gradlew clean && ./gradlew assembleDevRelease",
    "build:android:prod": "cd android && ./gradlew clean && ./gradlew assembleProdRelease",
    "genAab:dev": "cd android && ./gradlew clean && ./gradlew bundleDevRelease",
    "genAab:prod": "cd android && ./gradlew clean && ./gradlew bundleProdRelease",
    "android:clean": "cd android && ./gradlew --stop && ./gradlew clean"
  },
